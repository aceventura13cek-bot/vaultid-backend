from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from app.db.init_db import init_db
from app.routes.auth import router as auth_router
from app.routes.oauth import router as oauth_router   # ✅ UNCOMMENTED
from app.routes.ai import router as ai_router 

app = FastAPI(title="VaultID Identity Provider")

# CORS Configuration (allows frontend to connect)
app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://localhost:5173", "http://127.0.0.1:8000", "null", "*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

@app.on_event("startup")
def startup():
    init_db()

# Include routers
app.include_router(auth_router)
app.include_router(oauth_router)   # ✅ UNCOMMENTED
from app.routes.ai import router as ai_router
app.include_router(ai_router)
app.include_router(ai_router)  
@app.get("/")
def health_check():
    return {"status": "VaultID backend running"}